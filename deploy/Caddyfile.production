# Caddyfile de production — Zagoor / RestoSaas
# Copier vers /etc/caddy/Caddyfile et remplacer zagoor.com
# puis : sudo systemctl reload caddy

# Redirection www → domaine racine
www.zagoor.com {
	redir https://zagoor.com{uri} permanent
}

zagoor.com {
	encode gzip

	# Proxy vers l'app Next.js standalone (npm start, port 3000)
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Cache léger des assets statiques Next.js
	@static path /_next/static/* /icons/* /manifest.json /logo.svg
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy 127.0.0.1:3000
	}

	# Logs d'accès
	log {
		output file /var/log/caddy/zagoor-access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}
