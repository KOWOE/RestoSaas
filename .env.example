# ============================================================================
# Zagoor / RestoSaas — Variables d'environnement (exemple)
# Copier vers `.env` puis remplir les valeurs. Ne JAMAIS commiter `.env`.
# ============================================================================

# --- Base de données ---------------------------------------------------------
# PRODUCTION (Vercel) : PostgreSQL OBLIGATOIRE (ex: Neon) — SQLite ne persiste pas.
# Exemple : postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/restosaas"

# --- Session / Authentification ---------------------------------------------
# Secret de signature des sessions (HMAC). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OBLIGATOIRE en production (le serveur refuse de démarrer sans).
SESSION_SECRET=""

# Compte bootstrap (super admin) — utilisé seulement si absent de la base.
# En production, ces deux valeurs sont OBLIGATOIRES (pas de valeur par défaut).
ADMIN_EMAIL="admin@restaurant.com"
ADMIN_PASSWORD=""

# --- Passerelle de paiement Moneroo / FedaPay --------------------------------
# ⚠️ Les clés sont à créer dans la console Moneroo. NE JAMAIS les coder en dur.
MONEROO_URL="https://api.moneroo.io/v1/payments/initialize"
MONEROO_VERIFY_URL="https://api.moneroo.io/v1/payments"
MONEROO_SECRET_KEY=""

# Secret de signature des webhooks Moneroo (HMAC sha256 du corps de la requête).
MONEROO_WEBHOOK_SECRET=""

# true = accepte les webhooks NON signés (développement UNIQUEMENT, jamais en prod).
WEBHOOK_ALLOW_UNSIGNED="false"

# --- Divers ------------------------------------------------------------------
# URL publique de l'application (utilisée pour les return_url de paiement).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Token permettant de peupler la base de démo via POST /api/seed en production.
SEED_TOKEN=""

# Conserve pour compatibilité NextAuth si branché plus tard.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
