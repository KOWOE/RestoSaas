# ============================================================================
# Zagoor / RestoSaas — Variables d'environnement (exemple)
# Copier vers `.env` puis remplir les valeurs. Ne JAMAIS commiter `.env`.
# ============================================================================

# --- Base de données ---------------------------------------------------------
# PRODUCTION (Vercel) : PostgreSQL OBLIGATOIRE (Supabase recommandé) — SQLite ne persiste pas.
# Supabase → Project Settings → Database → Connection string → URI (mode "Session")
# Exemple : postgresql://postgres.PROJECT:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
DATABASE_URL=""

# Supabase fournit aussi DIRECT_URL : actuellement INUTILISÉ par le schéma Prisma
# (pas de directive directUrl). Vous pouvez la définir sur Vercel sans effet.
DIRECT_URL=""

# --- Session / Authentification ---------------------------------------------
# Secret de signature des sessions (HMAC). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OBLIGATOIRE en production (le serveur refuse de démarrer sans).
SESSION_SECRET=""

# Compte bootstrap (super admin) — utilisé seulement si absent de la base.
# En production, ces deux valeurs sont OBLIGATOIRES (pas de valeur par défaut).
ADMIN_EMAIL="admin@restaurant.com"
ADMIN_PASSWORD=""

# --- Passerelle de paiement Moneroo / FedaPay --------------------------------
# ⚠️ Les clés sont à créer dans la console Moneroo. NE JAMAIS les coder en dur.
MONEROO_URL="https://api.moneroo.io/v1/payments/initialize"
MONEROO_VERIFY_URL="https://api.moneroo.io/v1/payments"
# Accepté sous les deux noms (le code fait MONEROO_SECRET_KEY || MONEROO_SECRET)
MONEROO_SECRET_KEY=""

# URL/identifiant du webhook créé dans la console Moneroo (hooks.moneroo.io/ho_…).
MONEROO_WEBHOOK_URL=""

# Secret de signature des webhooks Moneroo (HMAC sha256 du corps de la requête),
# affiché avec le webhook (préfixe ih_…). À ne jamais commiter.
MONEROO_WEBHOOK_SECRET=""

# true = accepte les webhooks NON signés (développement UNIQUEMENT, jamais en prod).
WEBHOOK_ALLOW_UNSIGNED="false"

# --- Divers ------------------------------------------------------------------
# URL publique de l'application (utilisée pour les return_url de paiement).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Token permettant de peupler la base de démo via POST /api/seed en production.
SEED_TOKEN=""

# Conserve pour compatibilité NextAuth si branché plus tard.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Supabase (optionnel — pour Auth/Storage/Realtime Supabase ultérieurs) ---
# Project Settings → API → Project URL + Publishable key (sb_publishable_…)
# ⚠️ Ce n'est PAS DATABASE_URL : Prima utilise l'URI PostgreSQL (voir ci-dessus).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
